<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DriveRadar</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>2.1</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.radarbot.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>radarbot</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>DriveRadar shows what's playing and lets you pause or skip tracks while driving.</string>
	<key>NSContactsUsageDescription</key>
	<string>DriveRadar needs access to your contacts so you can choose a contact's location as your destination.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DriveRadar keeps navigation prompts, hazard alerts, and trip recording working while the screen is off.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>DriveRadar keeps navigation prompts, hazard alerts, and trip recording working while the screen is off.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DriveRadar uses your location for live speed, mapped speed limits, turn-by-turn navigation, hazard alerts, and trip insights.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>DriveRadar uses the microphone so you can say your destination.</string>
	<key>NSMotionUsageDescription</key>
	<string>DriveRadar uses motion sensors for hard-cornering insights.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DriveRadar lets you pick a profile photo from your library.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>DriveRadar converts your speech to text to search for destinations.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchWordmark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>gps</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
